---
import ViewCounter from './ViewCounter.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200">
	<div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-2 px-6 py-8 text-sm text-slate-500">
		<p>&copy; {year} 정환석. 공개 엔지니어링 증거로 만들어갑니다.</p>
		<p class="flex gap-3">
			<ViewCounter mode="page" />
			<ViewCounter mode="total" />
		</p>
	</div>
</footer>
