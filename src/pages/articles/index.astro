---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentList from '../../components/ContentList.astro';
import { sortByDateDesc } from '../../utils/content';

const modules = import.meta.glob('./*.md', { eager: true });
const articles = sortByDateDesc(modules);
---

<BaseLayout
	title="Articles"
	description="AI 시스템 개발 과정에서의 기술적 고민과 선택, 그리고 외부 기술 자료 리뷰를 기록합니다."
>
	<h1 class="text-2xl font-semibold text-slate-900">Articles</h1>
	<ContentList items={articles} emptyMessage="아티클을 준비하고 있습니다." />
</BaseLayout>
