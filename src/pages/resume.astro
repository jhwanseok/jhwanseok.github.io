---
import BaseLayout from '../layouts/BaseLayout.astro';

const tagClass =
	'inline-flex items-center rounded-full border border-slate-200 px-2.5 py-0.5 text-xs text-slate-600';

const careerJourney = [
	{
		company: 'Hyundai AutoEver',
		role: 'AI Engineer',
		period: '2024 – Present',
		current: true,
		description:
			'엔터프라이즈 환경에서 고객센터 Voice AI 시스템을 개발하고 있습니다. LLM 기반 기능 개발과 AI 서비스 운영을 위한 시스템 설계 및 개선에 집중하고 있습니다.',
	},
	{
		company: 'ESTsoft',
		role: 'AI Research Engineer',
		period: '2022 – 2024',
		description:
			'Voice AI와 LLM을 중심으로 연구와 서비스 개발을 수행했습니다. TTS, STT, Open LLM 등 다양한 프로젝트를 통해 AI 모델을 실제 서비스에 적용하는 경험을 쌓았습니다.',
	},
	{
		company: 'AITOK',
		role: 'Backend & AI Engineer',
		period: '2020 – 2022',
		description:
			'온라인 강의를 위한 STT 서비스 READEO를 개발했습니다. AI 모델뿐 아니라 Backend API와 서비스 구조를 함께 설계하며 AI 서비스 개발의 기반을 다졌습니다.',
	},
	{
		company: 'LOCS',
		role: 'Backend & AI Development',
		period: '2018 – 2020',
		description:
			'Python 기반 백엔드 개발과 자연어처리, 음성 AI 프로젝트를 수행하며 AI 시스템 개발의 기반을 다졌습니다.',
	},
];

const coreExpertise = [
	{
		title: 'Voice AI',
		description: 'STT, TTS, VoiceBot을 포함한 음성 AI 시스템을 설계하고 개발합니다.',
	},
	{
		title: 'LLM Systems',
		description: 'LLM Fine-tuning과 Evaluation을 통해 실제 서비스에 적용 가능한 LLM 시스템을 구축합니다.',
	},
	{
		title: 'Backend Engineering',
		description: 'FastAPI를 중심으로 AI 기능을 서비스 형태로 제공하는 Backend를 개발합니다.',
	},
	{
		title: 'AI Infrastructure',
		description:
			'Docker, Kubernetes, AWS 기반의 배포 및 운영 환경을 구축하며 운영 가능한 AI 시스템을 만드는 데 집중합니다.',
	},
];

const selectedWork = [
	{
		title: 'Enterprise Voice AI',
		description:
			'고객센터 환경을 위한 Voice AI 시스템을 개발하고 운영하며, 음성 인터페이스와 LLM을 결합한 서비스를 구축했습니다.',
		projects: ['Enterprise VoiceBot', 'LLM-powered Voice Assistant'],
	},
	{
		title: 'Speech AI',
		description: 'STT와 TTS를 활용한 음성 AI 시스템을 개발하고 성능을 개선했습니다.',
		projects: ['Whisper Fine-tuning for Korean STT', 'TTS Pipeline Improvement'],
	},
	{
		title: 'LLM Applications',
		description: 'Open LLM을 활용한 Fine-tuning과 LLM 기반 기능을 연구하고 실제 서비스에 적용했습니다.',
		projects: ['Open LLM Fine-tuning', 'LLM-based AI Features'],
	},
	{
		title: 'AI Service Engineering',
		description: 'AI 모델을 실제 서비스에서 운영하기 위한 Backend와 API를 설계하고 개발했습니다.',
		projects: ['AI Backend APIs', 'AI Service Architecture'],
	},
];

const technicalSkills = [
	{ category: 'Languages', skills: ['Python'] },
	{ category: 'AI / ML', skills: ['PyTorch', 'Transformers', 'Whisper', 'PEFT', 'LoRA', 'QLoRA'] },
	{ category: 'Backend', skills: ['FastAPI', 'Django'] },
	{
		category: 'Infrastructure',
		skills: ['Docker', 'Kubernetes', 'AWS', 'GitHub Actions', 'GitLab CI/CD'],
	},
	{ category: 'Databases', skills: ['PostgreSQL', 'MySQL', 'Redis'] },
];
---

<BaseLayout title="Resume" description="정환석의 커리어 타임라인과 기술 스택, 프로젝트 경험을 정리한 이력서입니다.">
	<h1 class="text-2xl font-semibold text-slate-900">Resume</h1>

	<p class="mt-6 border-l-2 border-slate-200 pl-4 text-slate-700">
		Voice AI와 LLM을 중심으로 실제 운영 가능한 AI 시스템을 설계하고 구축하고 있습니다.
	</p>
	<p class="mt-4 border-l-2 border-slate-200 pl-4 text-slate-700">
		지난 7년 동안 AI 모델 개발부터 백엔드, 인프라, 서비스 운영까지 다양한 영역을 경험하며, AI를
		제품으로 만드는 엔지니어링에 집중해 왔습니다.
	</p>
	<p class="mt-4 border-l-2 border-slate-200 pl-4 text-slate-700">
		현재는 엔터프라이즈 환경에서 신뢰할 수 있고 유지보수 가능한 AI 시스템을 만드는 일을 하고
		있습니다.
	</p>

	<section class="mt-16 border-t border-slate-200 pt-12">
		<h2 class="text-lg font-semibold text-slate-900">Career Journey</h2>
		<ol class="relative mt-8 ml-1.5 border-l border-slate-200">
			{
				careerJourney.map((job) => (
					<li class="relative mb-10 pl-8 last:mb-0">
						<span
							class:list={[
								'absolute -left-1.5 top-1.5 h-3 w-3 rounded-full ring-4 ring-white',
								job.current ? 'bg-slate-900' : 'bg-slate-300',
							]}
						/>
						<div class="flex flex-wrap items-center gap-2">
							<span class="text-sm text-slate-500">{job.period}</span>
							{job.current && <span class={tagClass}>재직 중</span>}
						</div>
						<h3 class="mt-1 text-base font-semibold text-slate-900">{job.company}</h3>
						<p class="text-sm text-slate-600">{job.role}</p>
						<p class="mt-2 text-slate-600">{job.description}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="mt-16 border-t border-slate-200 pt-12">
		<h2 class="text-lg font-semibold text-slate-900">Core Expertise</h2>
		<div class="mt-8 grid gap-8 sm:grid-cols-2">
			{
				coreExpertise.map((item) => (
					<div>
						<h3 class="text-base font-semibold text-slate-900">{item.title}</h3>
						<p class="mt-2 text-slate-600">{item.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="mt-16 border-t border-slate-200 pt-12">
		<h2 class="text-lg font-semibold text-slate-900">Selected Engineering Work</h2>
		<div class="mt-8 divide-y divide-slate-200">
			{
				selectedWork.map((work) => (
					<div class="py-6 first:pt-0 last:pb-0">
						<h3 class="text-base font-semibold text-slate-900">{work.title}</h3>
						<p class="mt-2 text-slate-600">{work.description}</p>
						<div class="mt-4 flex flex-wrap gap-2">
							{work.projects.map((project) => (
								<span class={tagClass}>{project}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="mt-16 border-t border-slate-200 pt-12">
		<h2 class="text-lg font-semibold text-slate-900">Technical Skills</h2>
		<div class="mt-8 grid gap-8 sm:grid-cols-2">
			{
				technicalSkills.map((group) => (
					<div>
						<h3 class="text-base font-semibold text-slate-900">{group.category}</h3>
						<div class="mt-3 flex flex-wrap gap-2">
							{group.skills.map((skill) => (
								<span class={tagClass}>{skill}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="mt-16 border-t border-slate-200 pt-12">
		<h2 class="text-lg font-semibold text-slate-900">Education</h2>
		<div class="mt-8">
			<h3 class="text-base font-semibold text-slate-900">Pukyong National University</h3>
			<p class="mt-2 text-slate-600">B.B.A. in Business Administration</p>
			<p class="text-slate-600">Double Major in Industrial & Management Engineering</p>
			<p class="mt-2 text-sm text-slate-500">2012.03 – 2020.02</p>
		</div>
	</section>

	<p class="mt-16 border-l-2 border-slate-200 pl-4 text-slate-700">
		대부분의 엔지니어링은 이력서 몇 줄로 설명되지 않습니다.
	</p>
	<p class="mt-4 border-l-2 border-slate-200 pl-4 text-slate-700">
		프로젝트와 기술 글에서는 설계 과정과 기술적 의사결정을 함께 기록하고 있습니다.
	</p>
</BaseLayout>
