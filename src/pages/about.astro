---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
	<h1 class="text-2xl font-semibold text-slate-900">About</h1>
	<p class="mt-4 text-slate-600">
		I'm an Enterprise AI Engineer. My focus is not only on AI models, but on delivering reliable,
		maintainable, and scalable systems that solve real-world problems.
	</p>
	<p class="mt-4 text-slate-600">
		This site is where I share that work — projects, technical writing, and the reasoning behind
		engineering decisions — as public, verifiable evidence rather than claims.
	</p>
</BaseLayout>
